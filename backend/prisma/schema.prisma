generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   Int          @id @default(autoincrement())
  nombreUsuario        String       @unique
  passwordHash         String
  nombre               String
  rol                  String
  activo               Boolean      @default(true)
  createdAt            DateTime     @default(now())
  ventas               Venta[]
  cajasAbiertas        CajaSesion[] @relation("AperturaCaja")
  cajasCerradas        CajaSesion[] @relation("CierreCaja")
}

model Producto {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique
  nombre         String
  categoria      String
  precioRegular  Float
  precioOferta   Float
  stock          Int
  esPrime        Boolean  @default(false)
  imagenUrl      String
  activo         Boolean  @default(true)
  itemsVenta     ItemVenta[]
}

model Categoria {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Cupon {
  id              Int     @id @default(autoincrement())
  codigo          String  @unique
  montoDescuento  Float
  activo          Boolean @default(true)
  ventas          Venta[]
}

model CorrelativoComprobante {
  tipo         String @id
  ultimoNumero Int    @default(0)
}

model CajaSesion {
  id                   Int       @id @default(autoincrement())
  montoApertura        Float
  fechaApertura        DateTime  @default(now())
  usuarioAperturaId    Int
  usuarioApertura      Usuario   @relation("AperturaCaja", fields: [usuarioAperturaId], references: [id])
  fechaCierre          DateTime?
  montoCierreDeclarado Float?
  usuarioCierreId      Int?
  usuarioCierre        Usuario?  @relation("CierreCaja", fields: [usuarioCierreId], references: [id])
  estado               String    @default("ABIERTA")
  ventas               Venta[]
}

model Venta {
  id                      Int             @id @default(autoincrement())
  numeroComprobante       String          @unique
  tipoComprobante         String
  metodoPago              String          @default("EFECTIVO")
  clienteTipoDocumento    String?
  clienteNumeroDocumento  String?
  clienteRuc              String?
  clienteRazonSocial      String?
  cuponId                 Int?
  cuponMontoDescuento     Float           @default(0)
  totalProductos          Float
  descuentoAplicado       Float
  igvDesglosado           Float
  totalPagar              Float
  fecha                   DateTime        @default(now())
  usuarioId               Int
  usuario                 Usuario         @relation(fields: [usuarioId], references: [id])
  cupon                   Cupon?          @relation(fields: [cuponId], references: [id])
  cajaSesionId            Int?
  cajaSesion              CajaSesion?     @relation(fields: [cajaSesionId], references: [id])
  items                   ItemVenta[]
}

model ItemVenta {
  id              Int      @id @default(autoincrement())
  ventaId         Int
  venta           Venta    @relation(fields: [ventaId], references: [id])
  productoId      Int
  producto        Producto @relation(fields: [productoId], references: [id])
  nombreProducto  String
  categoria       String
  cantidad        Int
  precioUnitario  Float
  subtotal        Float
}
